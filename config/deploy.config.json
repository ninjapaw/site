{
  "configVersion": "1.0.0",
  "project": {
    "name": "Ninja Paws HQ",
    "slug": "ninjapaws-hq",
    "organization": "Ninja Paw",
    "license": "MIT",
    "repository": "https://github.com/ninjapaw/site",
    "support": "https://github.com/ninjapaw/site/issues"
  },
  "defaults": {
    "deploymentTarget": "azure-static-web-app",
    "location": "centralus",
    "siteSku": "Free",
    "siteBase": "/",
    "secrets": { "mode": "none" },
    "resolver": {
      "required": [
        "azureEnvironment",
        "staticWebAppName",
        "customDomain",
        "publicSiteUrl"
      ],
      "env": {
        "DEPLOYMENT_TARGET": "deploymentTarget",
        "AZURE_STATIC_WEB_APP_NAME": "staticWebAppName",
        "AZURE_SITE_SKU": "siteSku",
        "AZURE_CUSTOM_DOMAIN": "customDomain",
        "AZURE_PUBLIC_SITE_URL": "publicSiteUrl",
        "PUBLIC_SITE_URL": "publicSiteUrl",
        "PUBLIC_SITE_BASE": "siteBase"
      }
    }
  },
  "environments": {
    "dev": {
      "branch": "dev",
      "githubEnvironment": "dev",
      "azureEnvironment": "development",
      "subscriptionId": "",
      "location": "centralus",
      "resourceGroup": "NP-NinjaPawsSite-Dev-CentralUS",
      "staticWebAppName": "np-ninjapaws-site-dev-centralus",
      "siteSku": "Free",
      "customDomain": "dev.ninjapaws.org",
      "publicSiteUrl": "https://dev.ninjapaws.org"
    },
    "prod": {
      "branch": "main",
      "githubEnvironment": "prod",
      "azureEnvironment": "production",
      "subscriptionId": "",
      "location": "centralus",
      "resourceGroup": "NP-NinjaPawsSite-CentralUS",
      "staticWebAppName": "np-ninjapaws-site-centralus",
      "siteSku": "Free",
      "customDomain": "ninjapaws.org",
      "publicSiteUrl": "https://ninjapaws.org"
    }
  }
}
