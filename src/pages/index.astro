---
import '../styles/global.css';

const projects = [
  {
    name: 'Cloud Security Dojo',
    type: 'Security engineering',
    description: 'A hands-on Azure training environment for detecting, remediating, and proving container risk.',
    href: 'https://github.com/ninjapaw/ninjapaws-cloud-security-dojo',
    tag: 'dojo',
    number: '01'
  },
  {
    name: 'Pawprint',
    type: 'Evidence & automation',
    description: 'Reproducible cloud scenarios that leave behind portable evidence you can diff, share, and audit.',
    href: 'https://github.com/ninjapaw/pawprint',
    tag: 'platform',
    number: '02'
  },
  {
    name: 'M365 Profiles',
    type: 'Identity & licensing',
    description: 'A practical decision tree that turns identity, workforce, and regulatory context into license guidance.',
    href: 'https://m365profiles.com',
    tag: 'identity',
    number: '03'
  },
  {
    name: 'Sentinel Optimizer',
    type: 'AI & cost intelligence',
    description: 'Client-side estimation and migration intelligence for making security telemetry more intentional.',
    href: 'https://sentineloptimizer.com',
    tag: 'ai',
    number: '04'
  },
  {
    name: 'Zero Trust Insights',
    type: 'Posture & governance',
    description: 'Evidence-backed posture reporting across identity, applications, controls, and policy drift.',
    href: 'https://github.com/ninjapaw/ninjapaws-zerotrust-insights',
    tag: 'identity',
    number: '05'
  },
  {
    name: 'Entra App Insights',
    type: 'Application governance',
    description: 'A focused assessment surface for app registrations, OAuth consent, permissions, and workload identity.',
    href: 'https://github.com/ninjapaw/entra-app-insights',
    tag: 'identity',
    number: '06'
  }
];

const navItems = [
  { label: 'Work', href: '#work' },
  { label: 'Method', href: '#method' },
  { label: 'Signal', href: '#signal' }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Ninja Paws builds practical security, identity, cloud, and AI tools for teams that need clearer signals and better decisions." />
    <meta name="theme-color" content="#101820" />
    <link rel="icon" type="image/svg+xml" href="/ninjapaws-mark.svg" />
    <title>Ninja Paws | Practical signal for modern teams</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="#top" aria-label="Ninja Paws home">
          <img src="/ninjapaws-mark.svg" alt="" width="38" height="38" />
          <span>Ninja <strong>Paws</strong></span>
        </a>
        <nav aria-label="Primary navigation">
          {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <a class="header-link" href="https://github.com/enterprises/ninjapaws" target="_blank" rel="noreferrer">
          Enterprise <span aria-hidden="true">↗</span>
        </a>
      </header>

      <main id="top">
        <section class="hero section-grid" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow"><span class="eyebrow-dot"></span> Independent practice / security + systems</p>
            <h1 id="hero-title">Make complex<br /><em>feel usable.</em></h1>
            <p class="hero-lede">Ninja Paws turns cloud security, identity, compliance, and AI into practical tools people can actually use.</p>
            <div class="hero-actions">
              <a class="button button-primary" href="#work">Explore the work <span aria-hidden="true">↓</span></a>
              <a class="text-link" href="https://github.com/ninjapaw" target="_blank" rel="noreferrer">View the GitHub <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="hero-signal" aria-label="Ninja Paws focus areas">
            <div class="signal-orbit orbit-one"></div>
            <div class="signal-orbit orbit-two"></div>
            <div class="signal-core"><img src="/ninjapaws-mark.svg" alt="Ninja Paws" width="96" height="96" /></div>
            <span class="signal-label label-top">IDENTITY</span>
            <span class="signal-label label-right">CLOUD</span>
            <span class="signal-label label-bottom">AI / DATA</span>
            <span class="signal-label label-left">TRUST</span>
          </div>
        </section>

        <section class="ticker" aria-label="Areas of practice">
          <div class="ticker-track"><span>SECURITY ENGINEERING</span><b>✦</b><span>ZERO TRUST</span><b>✦</b><span>AI THAT EARNS ITS KEEP</span><b>✦</b><span>OPEN LEARNING</span><b>✦</b><span>SECURITY ENGINEERING</span><b>✦</b><span>ZERO TRUST</span><b>✦</b></div>
        </section>

        <section class="intro section-grid" id="method" aria-labelledby="method-title">
          <div class="section-kicker">01 / The point</div>
          <div class="intro-content">
            <h2 id="method-title">Good security work<br /><span>leaves a signal.</span></h2>
            <div class="intro-columns">
              <p>Not another dashboard. Not a slide deck that disappears after the meeting. We build small, sharp systems that make the important thing easier to see and the next move easier to make.</p>
              <p class="muted">Our work lives at the intersection of <strong>evidence</strong>, <strong>explanation</strong>, and <strong>action</strong> — with just enough AI to remove friction, never to add mystery.</p>
            </div>
          </div>
        </section>

        <section class="work section-grid" id="work" aria-labelledby="work-title">
          <div class="work-heading">
            <div class="section-kicker">02 / The work</div>
            <h2 id="work-title">Built in public.<br /><span>Made to travel.</span></h2>
            <p>Explore the tools, references, and experiments that make up the Ninja Paws field kit.</p>
          </div>
          <div class="work-list">
            <div class="filter-bar" role="group" aria-label="Filter projects">
              <button class="filter-button is-active" type="button" data-filter="all">All work</button>
              <button class="filter-button" type="button" data-filter="identity">Identity</button>
              <button class="filter-button" type="button" data-filter="security">Security</button>
              <button class="filter-button" type="button" data-filter="ai">AI + data</button>
            </div>
            <div class="project-grid">
              {projects.map((project) => (
                <a class="project-card" href={project.href} target="_blank" rel="noreferrer" data-category={project.tag === 'dojo' ? 'security' : project.tag}>
                  <span class="project-number">{project.number}</span>
                  <span class="project-type">{project.type}</span>
                  <h3>{project.name}</h3>
                  <p>{project.description}</p>
                  <span class="project-arrow" aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </div>
        </section>

        <section class="signal-section section-grid" id="signal" aria-labelledby="signal-title">
          <div class="section-kicker">03 / The signal</div>
          <div class="signal-panel">
            <div>
              <p class="eyebrow eyebrow-light"><span class="eyebrow-dot"></span> The working principle</p>
              <h2 id="signal-title">Clarity is<br /><em>a control.</em></h2>
            </div>
            <div class="signal-panel-copy">
              <p>When teams can see what changed, why it matters, and what to do next, security stops being a fog of competing alerts.</p>
              <a class="button button-light" href="https://github.com/ninjapaw" target="_blank" rel="noreferrer">Follow the trail <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </section>

        <section class="contact section-grid" aria-labelledby="contact-title">
          <div class="section-kicker">04 / Start here</div>
          <div class="contact-content">
            <h2 id="contact-title">Bring us the<br /><span>messy middle.</span></h2>
            <p>Questions, collaborations, research, or a problem that has outgrown a spreadsheet. The best first step is usually a clear conversation.</p>
            <a class="contact-link" href="mailto:info@ninjapaws.org">info@ninjapaws.org <span aria-hidden="true">↗</span></a>
          </div>
        </section>
      </main>

      <footer class="site-footer">
        <div class="footer-top">
          <a class="brand" href="#top"><img src="/ninjapaws-mark.svg" alt="" width="32" height="32" /><span>Ninja <strong>Paws</strong></span></a>
          <div class="footer-links"><a href="https://github.com/ninjapaw" target="_blank" rel="noreferrer">GitHub</a><a href="https://github.com/enterprises/ninjapaws" target="_blank" rel="noreferrer">Enterprise</a><a href="https://ninjapaws.org" target="_blank" rel="noreferrer">Ninjapaws.org</a></div>
          <span class="footer-location">Made for clearer signals<br />from the United States</span>
        </div>
        <div class="footer-bottom"><span>© 2026 Ninja Paws contributors</span><span>Independent community and demo practice. Validate before production use. See <a href="https://github.com/ninjapaw/.github/blob/main/DISCLAIMER.md" target="_blank" rel="noreferrer">full disclaimer</a>.</span></div>
      </footer>
    </div>
    <script>
      const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
      const cards = document.querySelectorAll<HTMLElement>('.project-card');
      filters.forEach((filter) => {
        filter.addEventListener('click', () => {
          filters.forEach((button) => button.classList.remove('is-active'));
          filter.classList.add('is-active');
          const selected = filter.dataset.filter;
          cards.forEach((card) => {
            card.hidden = selected !== 'all' && card.dataset.category !== selected;
          });
        });
      });
    </script>
  </body>
</html>